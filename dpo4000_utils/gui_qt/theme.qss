QMainWindow {
    background: #111827;
    color: #e5e7eb;
    font-family: Segoe UI, Arial, sans-serif;
    font-size: 10pt;
}

QWidget {
    color: #e5e7eb;
    font-family: Segoe UI, Arial, sans-serif;
    font-size: 10pt;
}

QFrame, QStackedWidget, QScrollArea, QScrollArea > QWidget > QWidget {
    background: #111827;
}

QGroupBox {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #ffffff;
    background: transparent;
}

QLabel {
    background: transparent;
    color: #e5e7eb;
}

QLabel#TitleLabel {
    background: transparent;
    color: #ffffff;
    font-size: 18pt;
    font-weight: 700;
}

QLabel#MutedLabel {
    background: transparent;
    color: #9ca3af;
}

QLabel#PreviewLabel {
    background: #0f172a;
    border: 1px solid #374151;
    border-radius: 8px;
    color: #9ca3af;
}

QLabel#DrawerTitle {
    color: #ffffff;
    font-size: 13pt;
    font-weight: 700;
}

QWidget#ControlDrawer {
    background: #111827;
}

QWidget#DrawerNav {
    background: #0f172a;
    border: 1px solid #1f2937;
    border-radius: 8px;
}

QWidget#DrawerControls {
    background: transparent;
}

QWidget#DrawerContent {
    background: #111827;
    border-right: 1px solid #374151;
}

QWidget#DrawerHeader {
    background: transparent;
}

QToolButton#DrawerNavButton {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 6px;
    color: #e5e7eb;
    padding: 9px 10px;
    text-align: left;
}

QToolButton#DrawerNavButton:hover {
    background: #374151;
}

QToolButton#DrawerNavButton:checked {
    background: #2563eb;
    border-color: #60a5fa;
    color: #ffffff;
    font-weight: 700;
}

QToolButton#DrawerUtilityButton,
QPushButton#DrawerShowButton {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 6px;
    color: #e5e7eb;
    padding: 7px 10px;
}

QToolButton#DrawerUtilityButton:hover,
QPushButton#DrawerShowButton:hover {
    background: #374151;
}

QToolButton#DrawerUtilityButton:checked {
    background: #2563eb;
    border-color: #60a5fa;
    color: #ffffff;
}

QToolButton#DrawerUtilityButton:disabled {
    background: #111827;
    border-color: #1f2937;
    color: #6b7280;
}

QSplitter#MainSplitter::handle {
    background: #1f2937;
    border: 1px solid #374151;
    margin: 4px 2px;
    width: 8px;
}

QSplitter#MainSplitter::handle:hover {
    background: #2563eb;
}

QLineEdit, QComboBox, QTextEdit {
    background: #0f172a;
    border: 1px solid #374151;
    border-radius: 6px;
    color: #f9fafb;
    padding: 6px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:disabled, QComboBox:disabled, QTextEdit:disabled {
    background: #111827;
    color: #9ca3af;
}

QComboBox QAbstractItemView {
    background: #1f2937;
    border: 1px solid #374151;
    color: #f9fafb;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QPushButton {
    background: #374151;
    border: 0;
    border-radius: 6px;
    color: #f9fafb;
    padding: 8px 12px;
}

QPushButton:hover {
    background: #4b5563;
}

QPushButton#AccentButton {
    background: #2563eb;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#AccentButton:hover {
    background: #1d4ed8;
}

QRadioButton, QCheckBox {
    background: transparent;
    color: #e5e7eb;
    spacing: 8px;
}

QRadioButton::indicator {
    background: #0f172a;
    border: 2px solid #9ca3af;
    border-radius: 8px;
    height: 16px;
    width: 16px;
}

QRadioButton::indicator:hover {
    border-color: #60a5fa;
}

QRadioButton::indicator:checked {
    background: #2563eb;
    border: 2px solid #bfdbfe;
}

QRadioButton::indicator:checked:hover {
    background: #1d4ed8;
    border-color: #ffffff;
}

QRadioButton::indicator:disabled {
    background: #111827;
    border-color: #4b5563;
}

QCheckBox::indicator {
    background: #0f172a;
    border: 2px solid #9ca3af;
    border-radius: 4px;
    height: 16px;
    width: 16px;
}

QCheckBox::indicator:hover {
    border-color: #60a5fa;
}

QCheckBox::indicator:checked {
    background: #2563eb;
    border: 2px solid #bfdbfe;
}

QStatusBar {
    background: #0f172a;
    color: #93c5fd;
}
