QMainWindow {
    background: #111827;
    color: #e5e7eb;
    font-family: Segoe UI, Arial, sans-serif;
    font-size: 10pt;
}

QWidget {
    color: #e5e7eb;
    font-family: Segoe UI, Arial, sans-serif;
    font-size: 10pt;
}

QFrame, QTabWidget, QStackedWidget, QScrollArea, QScrollArea > QWidget > QWidget {
    background: #111827;
}

QGroupBox {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #ffffff;
    background: transparent;
}

QLabel {
    background: transparent;
    color: #e5e7eb;
}

QLabel#TitleLabel {
    background: transparent;
    color: #ffffff;
    font-size: 18pt;
    font-weight: 700;
}

QLabel#MutedLabel {
    background: transparent;
    color: #9ca3af;
}

QLabel#PreviewLabel {
    background: #0f172a;
    border: 1px solid #374151;
    border-radius: 8px;
    color: #9ca3af;
}

QLineEdit, QComboBox, QTextEdit {
    background: #0f172a;
    border: 1px solid #374151;
    border-radius: 6px;
    color: #f9fafb;
    padding: 6px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:disabled, QComboBox:disabled, QTextEdit:disabled {
    background: #111827;
    color: #9ca3af;
}

QComboBox QAbstractItemView {
    background: #1f2937;
    border: 1px solid #374151;
    color: #f9fafb;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QPushButton {
    background: #374151;
    border: 0;
    border-radius: 6px;
    color: #f9fafb;
    padding: 8px 12px;
}

QPushButton:hover {
    background: #4b5563;
}

QPushButton#AccentButton {
    background: #2563eb;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#AccentButton:hover {
    background: #1d4ed8;
}

QTabWidget::pane {
    border: 1px solid #374151;
    border-radius: 6px;
    background: #111827;
}

QTabBar {
    background: #111827;
}

QTabBar::tab {
    background: #374151;
    color: #e5e7eb;
    padding: 8px 14px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background: #2563eb;
    color: #ffffff;
}

QRadioButton, QCheckBox {
    background: transparent;
    color: #e5e7eb;
    spacing: 8px;
}

QRadioButton::indicator, QCheckBox::indicator {
    background: transparent;
}

QStatusBar {
    background: #0f172a;
    color: #93c5fd;
}
