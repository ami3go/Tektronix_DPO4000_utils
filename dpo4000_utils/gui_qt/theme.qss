QMainWindow {
    background: #111827;
    color: #e5e7eb;
    font-family: Segoe UI, Arial, sans-serif;
    font-size: 10pt;
}

QWidget {
    color: #e5e7eb;
    font-family: Segoe UI, Arial, sans-serif;
    font-size: 10pt;
}

QFrame, QStackedWidget, QScrollArea, QScrollArea > QWidget > QWidget {
    background: #111827;
}

QScrollArea#ChannelsScrollArea,
QScrollArea#TriggerScrollArea,
QScrollArea#AcquisitionScrollArea {
    background: #111827;
    border: 0;
}

QWidget#ChannelsScrollBody,
QWidget#TriggerScrollBody,
QWidget#AcquisitionScrollBody {
    background: #111827;
}

QScrollBar:vertical {
    background: #0f172a;
    border: 0;
    border-radius: 5px;
    margin: 0;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #374151;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #4b5563;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: 0;
    height: 0;
}

QGroupBox {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 8px;
    margin-top: 0;
    padding: 36px 14px 14px 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: 0;
    top: 2px;
    padding: 0 0 10px 0;
    color: #ffffff;
    background: transparent;
}

QGroupBox#CollapsibleContent {
    padding: 14px;
    margin-top: 0;
}

QGroupBox#InlineCollapsibleCard {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 8px;
    margin-top: 0;
    padding: 34px 12px 12px 12px;
    font-weight: 600;
}

QGroupBox#InlineCollapsibleCard:hover {
    border-color: #4b5563;
}

QGroupBox#InlineCollapsibleCard::title {
    subcontrol-origin: border;
    subcontrol-position: top left;
    left: 0;
    top: 0;
    padding: 8px 12px;
    color: #ffffff;
    background: #253142;
    border-bottom: 1px solid #374151;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}

QGroupBox#InlineCollapsibleContent {
    background: transparent;
    border: 0;
    margin-top: 0;
    padding: 0;
    font-weight: 400;
}

QGroupBox#InlineCollapsibleContent::title {
    color: transparent;
    padding: 0;
}

QLabel {
    background: transparent;
    color: #e5e7eb;
}

QLabel#TitleLabel {
    background: transparent;
    color: #ffffff;
    font-size: 18pt;
    font-weight: 700;
}

QLabel#MutedLabel {
    background: transparent;
    color: #9ca3af;
}

QLabel#PreviewLabel {
    background: #0f172a;
    border: 1px solid #374151;
    border-radius: 8px;
    color: #9ca3af;
}

QLabel#PreviewLabel:focus {
    border: 1px solid #60a5fa;
}

QLabel#DrawerTitle {
    color: #ffffff;
    font-size: 13pt;
    font-weight: 700;
}

QWidget#ScopeStatusStrip {
    background: #0f172a;
    border: 1px solid #1f2937;
    border-radius: 8px;
}

QLabel#StatusChip,
QLabel#StatusBadgeOk,
QLabel#StatusBadgeWarn,
QLabel#StatusBadgeBusy {
    background: #111827;
    border: 1px solid #374151;
    border-radius: 10px;
    color: #d1d5db;
    padding: 4px 8px;
}

QLabel#StatusBadgeOk {
    background: #064e3b;
    border-color: #10b981;
    color: #d1fae5;
    font-weight: 700;
}

QLabel#StatusBadgeWarn {
    background: #451a03;
    border-color: #f59e0b;
    color: #fde68a;
    font-weight: 700;
}

QLabel#StatusBadgeBusy {
    background: #172554;
    border-color: #60a5fa;
    color: #bfdbfe;
    font-weight: 700;
}

QToolButton#StatusActionButton {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 6px;
    color: #e5e7eb;
    padding: 5px 8px;
}

QToolButton#StatusActionButton:hover {
    background: #374151;
}

QWidget#QuickControlBar {
    background: #0f172a;
    border: 1px solid #1f2937;
    border-radius: 8px;
}

QToolButton#QuickControlButton,
QToolButton#QuickAccentButton {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 6px;
    color: #e5e7eb;
    padding: 6px 10px;
}

QToolButton#QuickControlButton:hover {
    background: #374151;
}

QToolButton#QuickAccentButton {
    background: #2563eb;
    border-color: #60a5fa;
    color: #ffffff;
    font-weight: 700;
}

QToolButton#QuickAccentButton:hover {
    background: #1d4ed8;
}

QToolButton#QuickControlButton:disabled,
QToolButton#QuickAccentButton:disabled,
QPushButton[scopeAction="true"]:disabled,
QToolButton[scopeAction="true"]:disabled {
    background: #111827;
    border-color: #1f2937;
    color: #6b7280;
}

QWidget#ApplicationMenuBar {
    background: #0f172a;
    border: 1px solid #1f2937;
    border-radius: 8px;
}

QLabel#ApplicationMenuTitle {
    color: #ffffff;
    font-weight: 700;
    padding: 0 10px 0 4px;
}

QToolButton#ApplicationMenuButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #d1d5db;
    padding: 6px 10px;
}

QToolButton#ApplicationMenuButton:hover {
    background: #1f2937;
    border-color: #374151;
}

QToolButton#ApplicationMenuButton:checked {
    background: #2563eb;
    border-color: #60a5fa;
    color: #ffffff;
    font-weight: 700;
}

QWidget#RightControlPanel {
    background: #111827;
    border: 1px solid #374151;
    border-radius: 8px;
}

QStackedWidget#RightControlStack {
    background: #111827;
    border: 0;
}

QLabel#ControlPageTitle {
    color: #ffffff;
    font-size: 13pt;
    font-weight: 700;
    padding: 0 0 4px 0;
}

QTabWidget#ControlTabs {
    background: #111827;
    border: 0;
}

QTabWidget#ControlTabs::pane {
    background: #111827;
    border: 1px solid #374151;
    border-radius: 8px;
    top: -1px;
}

QTabWidget#ControlTabs QTabBar::tab {
    background: #1f2937;
    border: 1px solid #374151;
    border-bottom: 0;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    color: #d1d5db;
    margin-right: 4px;
    padding: 8px 12px;
}

QTabWidget#ControlTabs QTabBar::tab:hover {
    background: #374151;
}

QTabWidget#ControlTabs QTabBar::tab:selected {
    background: #2563eb;
    border-color: #60a5fa;
    color: #ffffff;
    font-weight: 700;
}

QWidget#ControlDrawer {
    background: #111827;
}

QWidget#DrawerNav {
    background: #0f172a;
    border: 1px solid #1f2937;
    border-radius: 8px;
}

QWidget#DrawerControls {
    background: transparent;
}

QWidget#DrawerContent {
    background: #111827;
    border-right: 1px solid #374151;
}

QWidget#DrawerHeader {
    background: transparent;
}

QToolButton#CompactModeButton,
QToolButton#CollapsibleHeader {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 6px;
    color: #e5e7eb;
    padding: 7px 10px;
    text-align: left;
}

QToolButton#CompactModeButton:hover,
QToolButton#CollapsibleHeader:hover {
    background: #374151;
}

QToolButton#CompactModeButton:checked {
    background: #2563eb;
    border-color: #60a5fa;
    color: #ffffff;
}

QWidget#CollapsibleSection {
    background: transparent;
}

QToolButton#DrawerNavButton {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 8px;
    color: #e5e7eb;
    padding: 7px 4px;
    text-align: center;
}

QToolButton#DrawerNavButton:hover {
    background: #374151;
}

QToolButton#DrawerNavButton:checked {
    background: #2563eb;
    border-color: #60a5fa;
    color: #ffffff;
    font-weight: 700;
}

QToolButton#DrawerUtilityButton,
QPushButton#DrawerShowButton {
    background: #1f2937;
    border: 1px solid #374151;
    border-radius: 6px;
    color: #e5e7eb;
    padding: 7px 6px;
}

QToolButton#DrawerUtilityButton:hover,
QPushButton#DrawerShowButton:hover {
    background: #374151;
}

QToolButton#DrawerUtilityButton:checked {
    background: #2563eb;
    border-color: #60a5fa;
    color: #ffffff;
}

QToolButton#DrawerUtilityButton:disabled {
    background: #111827;
    border-color: #1f2937;
    color: #6b7280;
}

QSplitter#MainSplitter::handle {
    background: #1f2937;
    border: 1px solid #374151;
    margin: 4px 2px;
    width: 8px;
}

QSplitter#MainSplitter::handle:hover {
    background: #2563eb;
}

QLineEdit, QComboBox, QTextEdit {
    background: #0f172a;
    border: 1px solid #374151;
    border-radius: 6px;
    color: #f9fafb;
    padding: 6px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:disabled, QComboBox:disabled, QTextEdit:disabled {
    background: #111827;
    color: #9ca3af;
}

QComboBox QAbstractItemView {
    background: #1f2937;
    border: 1px solid #374151;
    color: #f9fafb;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QPushButton {
    background: #374151;
    border: 0;
    border-radius: 6px;
    color: #f9fafb;
    padding: 8px 12px;
}

QPushButton:hover {
    background: #4b5563;
}

QPushButton#AccentButton {
    background: #2563eb;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#AccentButton:hover {
    background: #1d4ed8;
}

QRadioButton, QCheckBox {
    background: transparent;
    color: #e5e7eb;
    spacing: 8px;
}

QRadioButton::indicator {
    background: #0f172a;
    border: 2px solid #9ca3af;
    border-radius: 8px;
    height: 16px;
    width: 16px;
}

QRadioButton::indicator:hover {
    border-color: #60a5fa;
}

QRadioButton::indicator:checked {
    background: #2563eb;
    border: 2px solid #bfdbfe;
}

QRadioButton::indicator:checked:hover {
    background: #1d4ed8;
    border-color: #ffffff;
}

QRadioButton::indicator:disabled {
    background: #111827;
    border-color: #4b5563;
}

QCheckBox::indicator {
    background: #0f172a;
    border: 2px solid #9ca3af;
    border-radius: 4px;
    height: 16px;
    width: 16px;
}

QCheckBox::indicator:hover {
    border-color: #60a5fa;
}

QCheckBox::indicator:checked {
    background: #2563eb;
    border: 2px solid #bfdbfe;
}

QStatusBar {
    background: #0f172a;
    color: #93c5fd;
}
